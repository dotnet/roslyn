<?xml version="1.0" encoding="utf-8"?>
<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <MicrosoftCodeAnalysisGeneratorVersion>3.9.0</MicrosoftCodeAnalysisGeneratorVersion>
    <MicrosoftVisualStudioInterop18Version>18.10.605</MicrosoftVisualStudioInterop18Version>
    <RoslynSdkNuGetApiVersion Condition="'$(TargetFramework)' == 'net461'">5.11.6</RoslynSdkNuGetApiVersion>
    <RoslynSdkNuGetApiVersion Condition="'$(TargetFramework)' == 'net472' OR '$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net10.0'">7.0.3</RoslynSdkNuGetApiVersion>
    <RoslynSdkNuGetApiVersion Condition="'$(RoslynSdkNuGetApiVersion)' == ''">6.3.4</RoslynSdkNuGetApiVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.EditorFeatures.Text" Version="4.12.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Testing.SourceGenerator" Version="5.10.0-1.26371.19" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Testing.Xunit" Version="5.10.0-1.26371.19" />
    <PackageVersion Include="Microsoft.VisualStudio.ProjectSystem.Managed" Version="17.3.51-g48943e0519" />
    <PackageVersion Include="Microsoft.VisualStudio.ProjectSystem.Managed.VS" Version="17.3.51-g48943e0519" />
    <PackageVersion Include="Microsoft.VisualStudio.ProjectSystem.SDK.Tools" Version="17.3.195-pre" />
    <PackageVersion Include="NuGet.Common" Version="$(RoslynSdkNuGetApiVersion)" />
    <PackageVersion Include="NuGet.Packaging" Version="$(RoslynSdkNuGetApiVersion)" />
    <PackageVersion Include="NuGet.Protocol" Version="$(RoslynSdkNuGetApiVersion)" />
    <PackageVersion Include="NuGet.Resolver" Version="$(RoslynSdkNuGetApiVersion)" />
    <PackageVersion Include="Nullable" Version="1.3.1" />
    <PackageVersion Include="System.Formats.Asn1" Version="9.0.6" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="System.Formats.Asn1" Version="6.0.1" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />

    <PackageVersion Update="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="$(MicrosoftVisualStudioInterop18Version)" />
    <PackageVersion Update="Microsoft.VisualStudio.ProjectSystem" Version="17.3.195-pre" />
    <PackageVersion Update="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.0.0-previews-1-31321-016" />
    <PackageVersion Update="NuGet.VisualStudio" Version="6.0.0-preview.3.158" />
  </ItemGroup>
</Project>
