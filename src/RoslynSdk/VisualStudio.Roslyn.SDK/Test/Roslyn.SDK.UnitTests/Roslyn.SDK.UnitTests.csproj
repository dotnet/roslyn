<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xUnit v3 test projects must build an executable; keep the .dll extension for VSTest discovery. -->
    <OutputType>Exe</OutputType>
    <TargetExt>.dll</TargetExt>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Microsoft.CodeAnalysis.Testing</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\Microsoft.CodeAnalysis.Testing\Test\Microsoft.CodeAnalysis.Testing.Utilities\WorkItemAttribute.cs" Link="WorkItemAttribute.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Roslyn.SDK\Roslyn.SDK.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Explicit reference to avoid missing package warning -->
    <PackageReference Include="Microsoft.VisualStudio.Interop" />
    <PackageReference Include="VSLangProj" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>
</Project>
