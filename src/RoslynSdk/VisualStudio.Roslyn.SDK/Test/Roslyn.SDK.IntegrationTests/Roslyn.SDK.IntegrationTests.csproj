<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseWPF>true</UseWPF>

    <RootNamespace>Microsoft.CodeAnalysis.Testing</RootNamespace>

    <!--
      This project uses xUnit v3, which conflicts with the xUnit v2 packages Roslyn's XUnit.targets
      adds to projects with IsTestProject=true (the default for a project whose name ends in "Tests").
      Disable that default and exclude the project from the DotNetBuildTests=false source-build path
      the same way IsTestProject would have.
    -->
    <IsTestProject>false</IsTestProject>
    <ExcludeFromDotNetBuild>true</ExcludeFromDotNetBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Microsoft.CodeAnalysis.Testing\Microsoft.CodeAnalysis.Analyzer.Testing\DefaultVerifier.cs" Link="DefaultVerifier.cs" />
    <Compile Include="..\..\..\Microsoft.CodeAnalysis.Testing\Microsoft.CodeAnalysis.Analyzer.Testing\ExceptionUtilities.cs" Link="ExceptionUtilities.cs" />
    <Compile Include="..\..\..\Microsoft.CodeAnalysis.Testing\Microsoft.CodeAnalysis.Analyzer.Testing\Extensions\IVerifierExtensions.cs" Link="IVerifierExtensions.cs" />
    <Compile Include="..\..\..\Microsoft.CodeAnalysis.Testing\Microsoft.CodeAnalysis.Analyzer.Testing\IVerifier.cs" Link="IVerifier.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="Microsoft.VisualStudio.SDK.Analyzers" PrivateAssets="all" />
    <PackageReference Include="NuGet.VisualStudio" />
    <PackageReference Include="Microsoft.VisualStudio.Interop" />
    <PackageReference Include="Nullable" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
    <!-- Xunit.Combinatorial 1.6.24 (the centrally pinned default) depends on xunit v2; 2.1.41 depends on xunit v3,
         which this project needs transitively via Microsoft.CodeAnalysis.Test.Utilities.IntegrationTests. -->
    <PackageReference Include="Xunit.Combinatorial" VersionOverride="2.1.41" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Compilers\Test\Core.IntegrationTests\Microsoft.CodeAnalysis.Test.Utilities.IntegrationTests.csproj" />
    <ProjectReference Include="..\..\Roslyn.SDK\Roslyn.SDK.csproj" CopyVsix="true" />
    <ProjectReference Include="..\..\..\..\VisualStudio\IntegrationTest\Harness\SourceGenerator\Microsoft.VisualStudio.Extensibility.Testing.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\..\..\VisualStudio\IntegrationTest\Harness\XUnit\Microsoft.VisualStudio.Extensibility.Testing.Xunit.csproj" />
  </ItemGroup>

  <Target Name="PrepareVsixProjectReferences"
          BeforeTargets="ResolveProjectReferences"
          DependsOnTargets="PrepareProjectReferences"
          Condition="'$(UsingToolVSSDK)' == 'true' and '$(MSBuildRuntimeType)' != 'Core'">
    <MSBuild
      Projects="@(_MSBuildProjectReferenceExistent)"
      Targets="VSIXContainerProjectOutputGroup"
      BuildInParallel="$(BuildInParallel)"
      Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework); CreateVsixContainer=true"
      Condition="'%(_MSBuildProjectReferenceExistent.CopyVsix)' == 'true'"
      ContinueOnError="!$(BuildingProject)"
      RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)">

      <Output TaskParameter="TargetOutputs" ItemName="_ProjectReferenceVsixOutputs" />
    </MSBuild>

    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(_ProjectReferenceVsixOutputs)" />
    </ItemGroup>
  </Target>

  <Import Project="..\..\..\..\VisualStudio\IntegrationTest\Harness\XUnitShared\build\Microsoft.VisualStudio.Extensibility.Testing.Xunit.targets" />

</Project>
