<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU5125;NU3005</NoWarn>
    <!-- These imported tests do not reference Roslyn.Test.Utilities, which is required by
         the repository's InstallTraceListener.cs module initializer. -->
    <SkipRoslynTestTraceListener>true</SkipRoslynTestTraceListener>

    <!-- Opt-out repo features -->
    <UsingToolXliff>false</UsingToolXliff>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TestTargetFrameworks>$(NetRoslyn);net472</TestTargetFrameworks>
    <SourceGeneratorTestTargetFrameworks>$(NetRoslyn);net472</SourceGeneratorTestTargetFrameworks>

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Language)' == 'C#'">
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CodeAnalysisRuleSet)" Condition="'$(CodeAnalysisRuleSet)' != ''" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
