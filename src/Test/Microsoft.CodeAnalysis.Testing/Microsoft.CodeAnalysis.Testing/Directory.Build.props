<Project>  
  <PropertyGroup>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- Opt-out repo features -->
    <UsingToolXliff>false</UsingToolXliff>

    <!--
      These projects use explicit Version= attributes on PackageReference items inherited from roslyn-sdk,
      which is incompatible with Roslyn's Central Package Management. Opt out here to preserve compatibility.
    -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <SupportsNet10Targeting>$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))</SupportsNet10Targeting>

    <!--
      net8.0: Modern .NET target with current NuGet APIs
      net10.0: Included when building with MSBuild 18.0+ toolsets
      netcoreapp3.1: Ensures full support for nullable reference types
      netstandard2.0/net472: Roslyn 3.x
    -->
    <TestingLibraryTargetFrameworks>net8.0;netcoreapp3.1;netstandard2.0;net461;net472</TestingLibraryTargetFrameworks>
    <TestingLibraryTargetFrameworks Condition="'$(SupportsNet10Targeting)' == 'True'">net10.0;$(TestingLibraryTargetFrameworks)</TestingLibraryTargetFrameworks>

    <!--
      netcoreapp3.1: Ensures full support for nullable reference types
      netstandard2.0/net472: Roslyn 3.x, starting with 3.8.0
    -->
    <TestingLibrarySourceGeneratorTargetFrameworks>netcoreapp3.1;netstandard2.0;net472</TestingLibrarySourceGeneratorTargetFrameworks>
  </PropertyGroup>
  
  <Choose>
    <When Condition="'$(Language)' == 'VB'">
      <PropertyGroup>
        <LangVersion>15.5</LangVersion>
      </PropertyGroup>
    </When>

    <When Condition="'$(Language)' == 'C#'">
      <PropertyGroup>
        <LangVersion>11</LangVersion>
      </PropertyGroup>
    </When>
  </Choose>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard1.6' OR '$(TargetFramework)' == 'netstandard2.0'">
    <!--
      The original Microsoft.CodeAnalysis packages targeted the PCL instead of .NET Standard. Rather than
      drop support for the packages, we use AssetTargetFallback to configure the NuGet restore behavior to
      work properly.
    -->
    <AssetTargetFallback>portable-net45+win8</AssetTargetFallback>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      NU1701: Package 'name' was restored using 'moniker' instead of the project target framework 'moniker'. This package may not be fully compatible with your project.
    -->
    <NoWarn>$(NoWarn);NU1701;NU3005;NU5125</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Version variables used by the testing library project files that are not defined in
      Roslyn's central version management (eng/Packages.props).
    -->
    <DiffPlexVersion>1.7.2</DiffPlexVersion>
    <SystemFormatsAsn1Version>9.0.6</SystemFormatsAsn1Version>
    <SystemNetHttpVersion>4.3.4</SystemNetHttpVersion>
  </PropertyGroup>

  <!-- We always want a good debugging experience in tests -->
  <PropertyGroup>
    <Optimize>false</Optimize>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CodeAnalysisRuleSet)" Condition="'$(CodeAnalysisRuleSet)' != ''" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Public API Analyzer configuration -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisAnalyzersVersion)" PrivateAssets="all" />
    <!--
      Use Update (not Include) for Roslyn.Diagnostics.Analyzers to avoid NU1504 duplicate with the
      parent Settings.props PackageReference, and to pin the version when CPM is disabled.
    -->
    <PackageReference Update="Roslyn.Diagnostics.Analyzers" Version="$(RoslynDiagnosticsAnalyzersVersion)" PrivateAssets="all" />
    <!-- Pin versions for other parent-injected analyzer packages that have no version when CPM is disabled -->
    <PackageReference Update="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" />
    <PackageReference Update="Microsoft.CodeAnalysis.PerformanceSensitiveAnalyzers" Version="3.3.4-beta1.22504.1" PrivateAssets="all" />
    <PackageReference Include="System.Net.Http" Version="$(SystemNetHttpVersion)" PrivateAssets="all" ExcludeAssets="all" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Needed to override the transitive 9.0.1 version brought in by the 16.1.1 Microsoft.NET.Test.Sdk -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" ExcludeAssets="all" />
  </ItemGroup>

</Project>
