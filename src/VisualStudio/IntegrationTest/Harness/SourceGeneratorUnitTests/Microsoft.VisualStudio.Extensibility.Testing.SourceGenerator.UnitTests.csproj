<Project>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetExt>.dll</TargetExt>
    <TargetFramework>net472</TargetFramework>
    <UseXunitV3>true</UseXunitV3>
  </PropertyGroup>

  <ItemGroup>
    <!-- This needs to be a package reference to avoid attempting to use a newer compiler version than either the CLI or IDE has. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="xunit.v3.mtp-off" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\Compilers\Shared\ThrowingTraceListener.cs" Link="ThrowingTraceListener.cs" />
    <Compile Remove="Resources\**\*.cs" />
    <EmbeddedResource Include="Resources\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\RoslynSdk\Microsoft.CodeAnalysis.Testing\Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing\Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.csproj" />
    <ProjectReference Include="..\XUnit\Microsoft.VisualStudio.Extensibility.Testing.Xunit.csproj" OutputItemType="CurrentContent" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" AdditionalProperties="GeneratePackageOnBuild=false" />
    <ProjectReference Include="..\SourceGenerator\Microsoft.VisualStudio.Extensibility.Testing.SourceGenerator.csproj" />
  </ItemGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />

  <Target Name="CreateXunitV3AppHost" AfterTargets="Build">
    <PropertyGroup>
      <_XunitV3AppHost>$(TargetDir)$(TargetName).exe</_XunitV3AppHost>
      <_TargetConfigPath>$(TargetPath).config</_TargetConfigPath>
      <_XunitV3AppHostConfig>$(_XunitV3AppHost).config</_XunitV3AppHostConfig>
    </PropertyGroup>

    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_XunitV3AppHost)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_TargetConfigPath)" DestinationFiles="$(_XunitV3AppHostConfig)" SkipUnchangedFiles="true" Condition="Exists('$(_TargetConfigPath)')" />
  </Target>

  <Target Name="UpdateContentPaths" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <Content Include="@(CurrentContent)" Link="Current\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
