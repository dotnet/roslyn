<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>

    <!--
      This self-executing xUnit v3 integration-test project manages its runner packages directly.
      Disable the default test-project targets and preserve their source-build exclusion.
    -->
    <IsTestProject>false</IsTestProject>
    <!-- This is an Exe (the xunit v3 self-executing test runner), not a conventional ".IntegrationTests.dll",
         so it must opt out of the Arcade naming-convention check as well. -->
    <IsIntegrationTestProject>false</IsIntegrationTestProject>
    <ExcludeFromDotNetBuild>true</ExcludeFromDotNetBuild>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" PrivateAssets="all" />
    <!--
      A Newtonsoft.Json package reference with insecure defaults is inherited, but not needed by this project.
      Override the reference to a secure version, but exclude it from the build and packaging.
    -->
    <PackageReference Include="Newtonsoft.Json" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="Xunit.Combinatorial" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Compilers\Test\Core\Microsoft.CodeAnalysis.Test.Utilities.csproj" />
    <ProjectReference Include="..\..\TestSetup\Microsoft.VisualStudio.IntegrationTest.Setup.csproj" />
    <ProjectReference Include="..\XUnit\Microsoft.VisualStudio.Extensibility.Testing.Xunit.csproj" />
    <ProjectReference Include="..\SourceGenerator\Microsoft.VisualStudio.Extensibility.Testing.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="..\XUnitShared\build\Microsoft.VisualStudio.Extensibility.Testing.Xunit.targets" />
  <Import Project="..\IntegrationTestsShared\Microsoft.VisualStudio.Extensibility.Testing.Xunit.IntegrationTests.Shared.projitems" Label="Shared" />
  <Import Project="..\..\..\..\..\src\Dependencies\Contracts\Microsoft.CodeAnalysis.Contracts.projitems" Label="Shared" />

</Project>
