<ctrls:ContextMenu x:Class="Microsoft.VisualStudio.LanguageServices.Implementation.InheritanceMargin.MarginGlyph.InheritanceMarginContextMenu"
                   x:ClassModifier="internal"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls;assembly=Microsoft.VisualStudio.Shell.Styles"
                   xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
                   xmlns:interop="clr-namespace:Microsoft.VisualStudio.Imaging.Interop;assembly=Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime"
                   xmlns:local="clr-namespace:Microsoft.VisualStudio.LanguageServices.Implementation.InheritanceMargin.MarginGlyph"
                   xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles;assembly=Microsoft.VisualStudio.Shell.Styles"
                   x:Name="InheritanceContextMenu"
                   MenuItem.SubmenuOpened="TargetsSubmenu_OnOpen"
                   MaxHeight="400"
                   StaysOpen="True"
                   TextOptions.TextRenderingMode="Grayscale">
  <ctrls:ContextMenu.Resources>
    <DataTemplate DataType="{x:Type interop:ImageMoniker}">
      <imaging:CrispImage imaging:CrispImage.ScaleFactor="{Binding DataContext.ScaleFactor, ElementName=InheritanceContextMenu}"
                          Moniker="{Binding Mode=OneTime}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:MenuItemViewModel}">
      <ctrls:TextBlock Text="{Binding DisplayContent, Mode=OneTime}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:DisambiguousTargetMenuItemViewModel}">
      <StackPanel Orientation="Horizontal">
        <imaging:CrispImage imaging:CrispImage.ScaleFactor="{Binding DataContext.ScaleFactor, ElementName=InheritanceContextMenu}"
                            Margin="{x:Static styles:Spacings.RightXS}"
                            Moniker="{Binding LanguageMoniker, Mode=OneTime}" />
        <ctrls:TextBlock Text="{Binding DisplayContent, Mode=OneTime}" />
      </StackPanel>
    </DataTemplate>

    <Style TargetType="{x:Type local:InheritanceMarginMenuItem}">
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName, Mode=OneTime}" />
      <Setter Property="Header" Value="{Binding Mode=OneTime}" />
      <Setter Property="Icon" Value="{Binding ImageMoniker, Mode=OneTime}" />
      <Setter Property="ItemsSource" Value="{Binding Targets, Mode=OneTime}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsHeader, Mode=OneTime}" Value="True">
          <Setter Property="Focusable" Value="False" />
          <Setter Property="IsHitTestVisible" Value="False" />
          <Setter Property="IsTabStop" Value="False" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsIndented, Mode=OneTime}" Value="True">
          <Setter Property="Margin" Value="{x:Static styles:Spacings.LeftL}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </ctrls:ContextMenu.Resources>
  <ctrls:ContextMenu.LayoutTransform>
    <ScaleTransform ScaleX="{Binding ScaleFactor, Mode=OneTime}" ScaleY="{Binding ScaleFactor, Mode=OneTime}" />
  </ctrls:ContextMenu.LayoutTransform>
  <ctrls:ContextMenu.Style>
    <Style TargetType="{x:Type local:InheritanceMarginContextMenu}">
      <Setter Property="ctrls:TextBlock.PreferredTextFormattingMode" Value="Ideal" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ScaleFactor, Mode=OneTime}" Value="1">
          <Setter Property="ctrls:TextBlock.PreferredTextFormattingMode" Value="{x:Null}" />
          <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </DataTrigger>
        <Trigger Property="IsOpen" Value="True">
          <Setter Property="ItemsSource" Value="{Binding MenuItemViewModels, Mode=OneTime}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </ctrls:ContextMenu.Style>
</ctrls:ContextMenu>
