<UserControl x:Class="Microsoft.VisualStudio.LanguageServices.DocumentOutline.DocumentOutlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls;assembly=Microsoft.VisualStudio.Shell.Styles"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:platformimaging="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:self="clr-namespace:Microsoft.VisualStudio.LanguageServices.DocumentOutline"
             xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles;assembly=Microsoft.VisualStudio.Shell.Styles"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             d:DataContext="{d:DesignInstance Type=self:DocumentOutlineViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d"
             platformimaging:ImageThemingUtilities.ImageBackgroundColor="{DynamicResource {x:Static styles:ShellColors.SolidBackgroundFillTertiaryColorKey}}"
             Background="{DynamicResource {x:Static styles:ShellColors.SolidBackgroundFillTertiaryBrushKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
             x:ClassModifier="internal">
  <UserControl.Resources>
    <!--  Live sorting avoids rebuilding the tree when model properties change.  -->
    <CollectionViewSource x:Key="DocumentSymbolItems"
                          IsLiveSortingRequested="True"
                          Source="{Binding DocumentSymbolViewModelItems}" />
    <self:DocumentSymbolDataViewModelSorter x:Key="ItemSorter" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ContentControl x:Name="Commands"
                    Grid.Row="0"
                    Focusable="True" />
    <Grid x:Name="SearchHost" Grid.Row="1" />
    <!--  Only user-initiated selection updates the source. Programmatic selection must not navigate
          the editor, since navigation moves the caret and can cause reentrancy.  -->
    <ctrls:TreeView x:Name="SymbolTree"
                   Grid.Row="2"
                   AutomationProperties.Name="{x:Static self:DocumentOutlineStrings.Document_Outline}"
                   ItemsSource="{Binding Source={StaticResource DocumentSymbolItems}}"
                   Visibility="{Binding Visibility, Mode=OneWayToSource}"
                   SourceUpdated="SymbolTree_SourceUpdated"
                   TreeViewItem.Selected="SymbolTreeItem_Selected">
      <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type self:DocumentSymbolDataViewModel}">
          <HierarchicalDataTemplate.ItemsSource>
            <MultiBinding Converter="{StaticResource ItemSorter}">
              <Binding Path="Children" />
              <Binding Path="DataContext.SortOption" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
            </MultiBinding>
          </HierarchicalDataTemplate.ItemsSource>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <imaging:CrispImage Margin="{x:Static styles:Spacings.RightXS}" Moniker="{Binding ImageMoniker}" />
            <ctrls:TextBlock Text="{Binding Data.Name}" />
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.Resources>
      <TreeView.ItemContainerStyle>
        <Style TargetType="{x:Type ctrls:TreeViewItem}">
          <Setter Property="AutomationProperties.Name" Value="{Binding Data.Name, Mode=OneWay}" />
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay, NotifyOnSourceUpdated=True, NotifyOnTargetUpdated=False}" />
        </Style>
      </TreeView.ItemContainerStyle>
    </ctrls:TreeView>
  </Grid>
</UserControl>
