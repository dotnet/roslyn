<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetRoslyn)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsShipping>false</IsShipping>
    <ExcludeFromSourceBuild>true</ExcludeFromSourceBuild>

    <!-- Allow the tool to roll forward to newer runtimes when available -->
    <RollForward>Major</RollForward>

    <ToolCommandName>roslyn-tools</ToolCommandName>
    <Description>Command line tool for performing Roslyn infrastructure tasks.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>

    <!--
      These identifiers are for generating the shim'd core executables for signing.
    -->
    <PackAsToolShimRuntimeIdentifiers Condition="'$(DotNetBuildSourceOnly)' != 'true'">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</PackAsToolShimRuntimeIdentifiers>

    <!-- enable building symbol packages -->
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <NoWarn>$(NoWarn);CS8002</NoWarn>

    <!-- 
      We do not set the NuGet package versions centrally because transitive pinning
      creates conflicts with the way Microsoft.CodeAnalysis.Testing works.
    -->
    <NuGetVersion>6.14.3</NuGetVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.DotNet.DarcLib" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.TeamFoundationServer.Client" />
    <PackageReference Include="Microsoft.TeamFoundationServer.ExtendedClient" />
    <PackageReference Include="Microsoft.VisualStudio.Services.InteractiveClient" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NuGet.Versioning" VersionOverride="$(NuGetVersion)" />
    <PackageReference Include="NuGet.Protocol" VersionOverride="$(NuGetVersion)" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.RoslynTools.UnitTests" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
