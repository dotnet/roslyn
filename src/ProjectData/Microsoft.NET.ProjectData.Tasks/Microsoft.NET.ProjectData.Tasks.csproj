<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetRoslynSourceBuild)</TargetFramework>
    <RootNamespace>Microsoft.NET.ProjectData.Tasks</RootNamespace>
    <!-- The SDK extracts this package and arranges its deployment layout; it is not intended for PackageReference consumption. -->
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- These members are used by source files that are intentionally not linked into this
         task assembly, so Roslyn's partial view reports them as unused. -->
    <NoWarn>$(NoWarn);IDE0051;IDE0060</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <_ProjectDataSchema>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Microsoft.NET.ProjectData.Generators\project-data-schema.json'))</_ProjectDataSchema>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild task base class and IBuildEngine. ExcludeAssets=runtime so the MSBuild
         assemblies are not copied to the output; MSBuild loads them from its own install. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="Runtime" PrivateAssets="All" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="System.IO.Pipelines" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Memory" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.NET.ProjectData.Generators\Microsoft.NET.ProjectData.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" SetPlatform="" />

    <Analyzer Include="$(PkgSystem_IO_Pipelines)\lib\netstandard2.0\System.IO.Pipelines.dll" />
    <Analyzer Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll" />

    <AdditionalFiles Include="..\Microsoft.NET.ProjectData.Generators\project-data-schema.json" />
    <InternalsVisibleTo Include="Microsoft.NET.ProjectData.Tasks.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The targets file ships next to this assembly so MSBuild can resolve the DLL via
         $(MSBuildThisFileDirectory). Copying it to the build output keeps both files together. -->
    <None Include="build\Microsoft.NET.ProjectData.targets" Link="Microsoft.NET.ProjectData.targets" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="lib\$(TargetFramework)\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the parts of Microsoft.NET.ProjectData that we are using; we could switch this over to consuming the
         library directly. -->
    <Compile Include="..\Microsoft.NET.ProjectData\UserFolderCachePath.cs" Link="Shared\UserFolderCachePath.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\Donor\ProjectDataDonorConfiguration.cs" Link="Shared\ProjectDataDonorConfiguration.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\Donor\ProjectDataDonorIndex.cs" Link="Shared\ProjectDataDonorIndex.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\Donor\ProjectDataDonorIndex.Serialization.cs" Link="Shared\ProjectDataDonorIndex.Serialization.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\Donor\ProjectDataDonorIndexEntry.cs" Link="Shared\ProjectDataDonorIndexEntry.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\Donor\ProjectDataDonorWriteOptions.cs" Link="Shared\ProjectDataDonorWriteOptions.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\UnsupportedProjectDataMarker.cs" Link="Shared\UnsupportedProjectDataMarker.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\ProjectDataBuildReceipt.cs" Link="Shared\ProjectDataBuildReceipt.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\ProjectDataBuildAttemptManifest.cs" Link="Shared\ProjectDataBuildAttemptManifest.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\ProjectDataBuildDiagnosticProtocol.cs" Link="Shared\ProjectDataBuildDiagnosticProtocol.cs" />
    <Compile Include="..\Microsoft.NET.ProjectData\HexEncoder.cs" Link="Shared\HexEncoder.cs" />
  </ItemGroup>

  <Target Name="_InitializeProjectDataSchemaProps"
          BeforeTargets="_GetPackageFiles;AssignTargetPaths">
    <PropertyGroup>
      <_GeneratedProjectDataProps>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)Microsoft.NET.ProjectData.Schema.props'))</_GeneratedProjectDataProps>
    </PropertyGroup>
    <ItemGroup>
      <!-- Generated property allow-list imported by the .targets; must travel with it. -->
      <None Include="$(_GeneratedProjectDataProps)" Link="Microsoft.NET.ProjectData.Schema.props" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="lib\$(TargetFramework)\" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="GenerateProjectDataProps"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SchemaFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(PkgSystem_Memory)\lib\netstandard2.0\System.Memory.dll" />
      <Reference Include="$(PkgSystem_Text_Json)\lib\netstandard2.0\System.Text.Json.dll" />
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text.Json" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Method" Language="cs">
        <![CDATA[
        public override bool Execute()
        {
            try
            {
                using var schema = JsonDocument.Parse(File.ReadAllText(SchemaFile));

                var properties = schema.RootElement.GetProperty("properties");
                var required = properties.GetProperty("required");
                var optional = properties.GetProperty("optional");
                if (required.ValueKind != JsonValueKind.Array ||
                    optional.ValueKind != JsonValueKind.Array)
                {
                    throw new InvalidDataException("Required and optional properties must be arrays.");
                }

                var entries = required.EnumerateArray()
                    .Concat(optional.EnumerateArray())
                    .OrderBy(entry => entry.GetProperty("name").GetString(), StringComparer.Ordinal);

                var items = new XElement("ItemGroup");

                foreach (var entry in entries)
                {
                    if (!entry.TryGetProperty("name", out var nameElement) ||
                        nameElement.ValueKind != JsonValueKind.String)
                    {
                        throw new InvalidDataException("Property name must be a string.");
                    }

                    var name = nameElement.GetString();
                    var hasValue = entry.TryGetProperty("value", out var valueElement);
                    if (hasValue &&
                        valueElement.ValueKind != JsonValueKind.String &&
                        valueElement.ValueKind != JsonValueKind.Null)
                    {
                        throw new InvalidDataException("Property value must be a string or null.");
                    }

                    var value = hasValue
                        ? valueElement.GetString()
                        : "$" + "(" + name + ")";

                    items.Add(new XElement("_ProjectDataProperties",
                        new XAttribute("Include", name),
                        new XElement("Value", value)));
                }

                var content = new XDocument(
                    new XComment(" <auto-generated/> "),
                    new XComment(" Auto-generated. Do not modify manually. "),
                    new XElement("Project", items)).ToString();

                File.WriteAllText(Path.GetFullPath(OutputFile), content);

                return true;
            }
            catch (Exception exception)
            {
                Log.LogErrorFromException(exception, showStackTrace: true);
                return false;
            }
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="_GenerateProjectDataSchemaProps"
          Condition="$(DesignTimeBuild) != 'true'"
          BeforeTargets="GetCopyToOutputDirectoryItems"
          DependsOnTargets="_InitializeProjectDataSchemaProps"
          Inputs="$(_ProjectDataSchema);$(MSBuildProjectFullPath)"
          Outputs="$(_GeneratedProjectDataProps)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_GeneratedProjectDataProps)'))" />
    <GenerateProjectDataProps SchemaFile="$(_ProjectDataSchema)" OutputFile="$(_GeneratedProjectDataProps)" />
    <ItemGroup>
      <FileWrites Include="$(_GeneratedProjectDataProps)" />
    </ItemGroup>
  </Target>
</Project>
