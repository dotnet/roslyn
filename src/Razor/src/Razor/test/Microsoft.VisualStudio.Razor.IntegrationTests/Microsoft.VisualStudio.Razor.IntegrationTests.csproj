<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0016;RS0017;RS0018;RS0022;RS0026;RS0027</NoWarn>
    <IsShipping>false</IsShipping>
    <AddPublicApiAnalyzers>false</AddPublicApiAnalyzers>
    <TargetFramework>$(NetFxVS)</TargetFramework>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>Microsoft.VisualStudio.Razor.IntegrationTests</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <ExcludeFromDotNetBuild>true</ExcludeFromDotNetBuild>

    <!-- Must use "dotnet test" to get blame-hang options -->
    <UseVSTestRunner>true</UseVSTestRunner>
    <TestRunnerAdditionalArguments>"--blame-hang-dump-type:full" "--blame-hang-timeout:20m"</TestRunnerAdditionalArguments>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\src\Microsoft.VisualStudio.RazorExtension\UnifiedSettings\razor.registration.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      IsTestProject=false above makes eng\targets\Imports.targets default ProjectReference items
      to Private=false (no copy-local), which is correct for an ordinary library but wrong here:
      this project hosts and executes its own tests via a custom in-process xUnit runner
      (TestDiscoveryWorker/InProcessTestProcessLauncher), so referenced projects' assemblies must
      be copied to this project's own output directory to be loadable at discovery/execution
      time. Set Private="true" explicitly to restore copy-local (RazorExtension already opts out
      via ReferenceOutputAssembly=false, and RazorDeployment's Private="False" below is
      intentional - it's deployed via VSIX, not copy-local).
    -->
    <ProjectReference Include="..\Microsoft.AspNetCore.Razor.Test.Common.Tooling\Microsoft.AspNetCore.Razor.Test.Common.Tooling.csproj" Private="true" />
    <ProjectReference Include="..\..\src\Microsoft.VisualStudio.LanguageServer.ContainedLanguage\Microsoft.VisualStudio.LanguageServer.ContainedLanguage.csproj" Private="true">
      <PrivateAssets>All</PrivateAssets>
      <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\src\Microsoft.VisualStudio.RazorExtension\Microsoft.VisualStudio.RazorExtension.csproj">
      <PrivateAssets>All</PrivateAssets>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
    </ProjectReference>
    <ProjectReference Include="..\..\src\RazorDeployment\RazorDeployment.csproj" Private="False" Condition="'$(BuildDependencyVsix)' == 'true'">
      <PrivateAssets>All</PrivateAssets>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Editor" />
    <ProjectReference Include="..\..\..\..\..\VisualStudio\IntegrationTest\Harness\XUnit\Microsoft.VisualStudio.Extensibility.Testing.Xunit.csproj" Private="true" />
    <ProjectReference Include="..\..\..\..\..\VisualStudio\IntegrationTest\Harness\SourceGenerator\Microsoft.VisualStudio.Extensibility.Testing.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SetTargetFramework="TargetFramework=netstandard2.0" SkipGetTargetFrameworkProperties="true" />
    <PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" />
    <PackageReference Include="NuGet.VisualStudio" />
    <PackageReference Include="NuGet.SolutionRestoreManager.Interop" />
    <!-- Manually upgrade to address CG alert. When the VS packages
         pull in the right version, this can be removed. -->
    <PackageReference Include="Microsoft.IO.Redist" Condition="'$(TargetFramework)' == '$(NetFxVS)'" />
    <PackageReference Include="Microsoft.Internal.VisualStudio.Shell.Framework" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <!-- Required by TestDiscoveryWorker's InProcessTestProcessLauncher, which checks that the
         test assembly links against xunit.v3.runner.inproc.console before discovery/execution. -->
    <PackageReference Include="xunit.v3.runner.inproc.console" />
    <PackageReference Include="Xunit.Combinatorial" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\TestFiles\**\*" />
  </ItemGroup>


  <Import Project="..\..\..\..\..\VisualStudio\IntegrationTest\Harness\XUnitShared\build\Microsoft.VisualStudio.Extensibility.Testing.Xunit.targets" />
</Project>
