<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>5f72aeab-d450-4339-83f3-855672914418</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Microsoft.CodeAnalysis.Razor.Formatting</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Resources\SR.resx">
      <GenerateSource>true</GenerateSource>
      <Namespace>Microsoft.CodeAnalysis.Razor.Formatting.Resources</Namespace>
      <LogicalName>Microsoft.CodeAnalysis.Razor.Formatting.Resources.SR.resources</LogicalName>
      <XlfTranslatedFilename>FormattingSR.resx</XlfTranslatedFilename>
    </EmbeddedResource>
    <None Include="$(MSBuildThisFileDirectory)Resources\xlf\SR*.xlf" />
  </ItemGroup>
</Project>
