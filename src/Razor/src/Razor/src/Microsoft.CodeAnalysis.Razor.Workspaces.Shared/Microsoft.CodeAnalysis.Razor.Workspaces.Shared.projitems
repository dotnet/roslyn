<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>a90bc9b4-5334-4c5a-bef5-502342ab4580</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Microsoft.CodeAnalysis.Razor.Workspaces.Shared</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)Resources\SR.resx">
      <GenerateSource>true</GenerateSource>
      <Namespace>Microsoft.CodeAnalysis.Razor.Workspaces.Shared.Resources</Namespace>
      <LogicalName>Microsoft.CodeAnalysis.Razor.Workspaces.Shared.Resources.SR.resources</LogicalName>
      <XlfTranslatedFilename>WorkspacesSharedSR.resx</XlfTranslatedFilename>
    </EmbeddedResource>
    <None Include="$(MSBuildThisFileDirectory)Resources\xlf\SR*.xlf" />
  </ItemGroup>
</Project>
