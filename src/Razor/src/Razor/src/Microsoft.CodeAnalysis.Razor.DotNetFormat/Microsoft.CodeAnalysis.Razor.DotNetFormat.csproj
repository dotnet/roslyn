<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NetVS)</TargetFramework>
    <Description>Razor document formatting support for dotnet format.</Description>
    <IsShippingPackage>false</IsShippingPackage>
    <!-- This is an SDK payload, not a library package; dotnet format already supplies the Roslyn dependencies. -->
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <ExcludeFromSourceOnlyBuild>false</ExcludeFromSourceOnlyBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\Compilers\Core\Portable\Microsoft.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\..\..\..\Compilers\CSharp\Portable\Microsoft.CodeAnalysis.CSharp.csproj" />
    <ProjectReference Include="..\..\..\..\..\Workspaces\Core\Portable\Microsoft.CodeAnalysis.Workspaces.csproj" />
    <ProjectReference Include="..\..\..\..\..\Workspaces\CSharp\Portable\Microsoft.CodeAnalysis.CSharp.Workspaces.csproj" />
    <ProjectReference Include="..\..\..\Compiler\Microsoft.CodeAnalysis.Razor.Compiler\src\Microsoft.CodeAnalysis.Razor.Compiler.csproj" />
    <ProjectReference Include="$(SharedSourceRoot)Microsoft.AspNetCore.Razor.Utilities.Shared\Microsoft.AspNetCore.Razor.Utilities.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the adapter payload small by compiling the required Razor sources rather than referencing Razor Workspaces. -->
    <Compile Include="..\Microsoft.VisualStudioCode.RazorExtension\ExternalAccess\Razor\RazorAnalyzerAssemblyResolver.cs" Link="RazorAnalyzerAssemblyResolver.cs" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="Microsoft.CodeAnalysis.Razor.DotNetFormat.UnitTests" Key="$(RazorKey)" />
  </ItemGroup>

  <Import Project="..\Microsoft.CodeAnalysis.Razor.Workspaces.Shared\Microsoft.CodeAnalysis.Razor.Workspaces.Shared.projitems" Label="Shared" />
  <Import Project="..\Microsoft.CodeAnalysis.Razor.Formatting\Microsoft.CodeAnalysis.Razor.Formatting.projitems" Label="Shared" />

  <Target Name="PackLayout" BeforeTargets="$(GenerateNuspecDependsOn)">
    <ItemGroup>
      <Content Include="$(TargetPath)" PackagePath="\dotnet-format" />
      <Content Include="$(TargetDir)**\$(AssemblyName).resources.dll" PackagePath="\dotnet-format\%(RecursiveDir)" />
      <Content Include="$(ArtifactsBinDir)Microsoft.CodeAnalysis.Razor.Compiler\$(Configuration)\$(TargetFramework)\Microsoft.CodeAnalysis.Razor.Compiler.dll" PackagePath="\dotnet-format" />
      <Content Include="$(ArtifactsBinDir)Microsoft.AspNetCore.Razor.Utilities.Shared\$(Configuration)\$(TargetFramework)\Microsoft.AspNetCore.Razor.Utilities.Shared.dll" PackagePath="\dotnet-format" />
    </ItemGroup>
  </Target>
</Project>
