<?xml version="1.0" encoding="utf-8"?>
<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <ItemGroup>
    <!-- Remove unneeded reference to AspNetCore.App. Projects that run on the ASP.NET Core shared framework set UseAspNetCoreFramework=true. -->
    <KnownFrameworkReference Remove="Microsoft.AspNetCore.App" Condition="'$(UseAspNetCoreFramework)' != 'true'" />
  </ItemGroup>

</Project>
