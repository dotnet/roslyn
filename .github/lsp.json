{
  "lspServers": {
    "csharp": {
      "command": "dotnet",
      "args": [
        "dnx",
        "roslyn-language-server@5.11.0-1-test.26420.13",
        "--source",
        "https://pkgs.dev.azure.com/azure-public/vside/_packaging/vs-impl/nuget/v3/index.json",
        "--",
        "--stdio",
        "--autoLoadProjects",
        "--logLevel",
        "Trace"
      ],
      "fileExtensions": {
        ".cs": "csharp",
        ".razor": "aspnetcorerazor",
        ".cshtml": "aspnetcorerazor"
      },
      "warmupTimeoutMs": 120000
    }
  }
}
