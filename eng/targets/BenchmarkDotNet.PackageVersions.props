<Project>
  <!-- BenchmarkDotNet's .NET Framework dependencies also apply to its generated runner projects.
       Keep the repository-wide System.Text.Json version aligned with MSBuild. -->
  <ItemGroup>
    <PackageVersion Update="System.IO.Pipelines" Version="10.0.11" Condition="'$(SystemIOPipelinesVersion)' != '' and $([MSBuild]::VersionLessThan('$(SystemIOPipelinesVersion)', '10.0.11'))" />
    <PackageVersion Update="System.Text.Encodings.Web" Version="10.0.11" Condition="'$(SystemTextEncodingsWebVersion)' != '' and $([MSBuild]::VersionLessThan('$(SystemTextEncodingsWebVersion)', '10.0.11'))" />
    <PackageVersion Update="System.Text.Json" Version="10.0.11" Condition="'$(SystemTextJsonVersion)' != '' and $([MSBuild]::VersionLessThan('$(SystemTextJsonVersion)', '10.0.11'))" />
    <PackageVersion Update="System.Threading.Channels" Version="10.0.11" Condition="'$(SystemThreadingChannelsVersion)' != '' and $([MSBuild]::VersionLessThan('$(SystemThreadingChannelsVersion)', '10.0.11'))" />
  </ItemGroup>
</Project>
