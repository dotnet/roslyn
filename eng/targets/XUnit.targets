<?xml version="1.0" encoding="utf-8"?>
<!-- Licensed to the .NET Foundation under one or more agreements. The .NET Foundation licenses this file to you under the MIT license. See the LICENSE file in the project root for more information. -->
<Project>

  <PropertyGroup>
    <PrepareForBuildDependsOn>$(PrepareForBuildDependsOn);AddDefaultTestAppConfig</PrepareForBuildDependsOn>

    <RoslynTestRunner Condition="'$(RoslynTestRunner)' == ''">VSTest</RoslynTestRunner>
    <_RoslynUseMicrosoftTestingPlatform Condition="'$(RoslynTestRunner)' == 'Microsoft.Testing.Platform'">true</_RoslynUseMicrosoftTestingPlatform>
    <_XunitMicrosoftTestingPlatformRunner Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true'">off</_XunitMicrosoftTestingPlatformRunner>
    <_XunitMicrosoftTestingPlatformRunner Condition="'$(_RoslynUseMicrosoftTestingPlatform)' == 'true'">true</_XunitMicrosoftTestingPlatformRunner>

    <!--
      xunit.v3 test projects build an executable capable of running under either VSTest or
      Microsoft.Testing.Platform (MTP). Roslyn's test infrastructure (CI harnesses, custom
      runners, xunit.runner.visualstudio) still targets VSTest by default. The opt-in MTP mode
      allows individual projects to validate the native runner while that infrastructure is migrated.
    -->
    <IsTestingPlatformApplication Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true'">false</IsTestingPlatformApplication>
    <IsTestingPlatformApplication Condition="'$(_RoslynUseMicrosoftTestingPlatform)' == 'true'">true</IsTestingPlatformApplication>

    <!-- xunit.v3 test projects must build an executable; keep the .dll extension for VSTest discovery. -->
    <OutputType>Exe</OutputType>
    <TargetExt Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true'">.dll</TargetExt>
    <TargetExt Condition="'$(_RoslynUseMicrosoftTestingPlatform)' == 'true' and '$(TargetFrameworkIdentifier)' == '.NETFramework'">.exe</TargetExt>

    <!-- 4 MB, matching the stack reserve of the testhost.net47x.exe that VSTest uses for non-xunit.v3 projects. -->
    <TestAssemblyStackReserve>4194304</TestAssemblyStackReserve>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="XunitXml.TestLogger" PrivateAssets="all" Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true'" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true'" />
    <PackageReference Include="xunit.v3.mtp-off" PrivateAssets="all" Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true'" />
    <PackageReference Include="xunit.v3" PrivateAssets="all" Condition="'$(_RoslynUseMicrosoftTestingPlatform)' == 'true'" />
    <PackageReference Include="xunit.analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <!-- Avoid xUnit's default path-dependent namespace suffix for its generated test entry point. -->
  <Target Name="_XunitGenerateEntryPoint"
          Inputs="@(XunitEntryPointCachePath)"
          Outputs="$(_XunitEntryPointPath)"
          Condition="'$(XunitAutoGeneratedEntryPoint)' != 'false'"
          DependsOnTargets="_XunitCreateEntryPointCache">
    <XunitGenerateEntryPoint
        SourcePath="$(_XunitEntryPointPath)"
        RootNamespace="$(RootNamespace)"
        SuffixSeed="$(MSBuildProjectName)"
        Language="$(Language)"
        UseMicrosoftTestingPlatformRunner="$(_XunitMicrosoftTestingPlatformRunner)" />
    <ItemGroup>
      <FileWrites Include="$(_XunitEntryPointPath)" />
    </ItemGroup>
  </Target>

  <!--
    xunit.runner.visualstudio copies xunit.abstractions.dll. Direct runners also need the
    framework-specific runner utility.
  -->
  <Target Name="_XunitCopyRunnerDependencies"
          AfterTargets="Build"
          Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true' and ('$(TargetFrameworkIdentifier)' == '.NETFramework' or '$(TargetFrameworkIdentifier)' == '.NETCoreApp') and '$(DotNetBuildSourceOnly)' != 'true'">
    <ItemGroup>
      <_XunitRunnerUtilityPackageReference Include="@(PackageReference)"
                                           Condition="'%(PackageReference.Identity)' == 'xunit.v3.runner.utility'" />
      <_XunitRunnerUtility
          Include="$(NuGetPackageRoot)xunit.v3.core.mtp-off\$(_xunitVersion)\_content\runners\netfx\xunit.v3.runner.utility.netfx.dll"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '@(_XunitRunnerUtilityPackageReference)' == ''" />
      <_XunitRunnerUtility
          Include="$(NuGetPackageRoot)xunit.v3.core.mtp-off\$(_xunitVersion)\_content\runners\netcore\xunit.v3.runner.utility.netcore.dll"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '@(_XunitRunnerUtilityPackageReference)' == ''" />
    </ItemGroup>

    <Copy SourceFiles="@(_XunitRunnerUtility)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Include BannedSymbols covering all test projects -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\config\test\BannedSymbols.txt" />
  </ItemGroup>

  <Target Name="ValidateRoslynTestRunner" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RoslynTestRunner)' != 'VSTest' and '$(RoslynTestRunner)' != 'Microsoft.Testing.Platform'"
           Text="Unsupported RoslynTestRunner value '$(RoslynTestRunner)'. Expected 'VSTest' or 'Microsoft.Testing.Platform'." />
  </Target>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework' AND '$(SkipRoslynTestTraceListener)' != 'true'">
    <!--
      For .NET Core, app.config is not available. Languages which support module initializers may provide an
      InstallTraceListener.* source file which gets added to the build for test projects to programmatically install the
      trace listener. Together with app.config support, this means the trace listener is automatically set for:

      1. All C# test projects
      2. All Visual Basic test projects running on .NET Framework
    -->
    <Compile Include="$(RepositoryEngineeringDir)config\test\Core\InstallTraceListener$(DefaultLanguageSourceExtension)"
             Condition="Exists('$(RepositoryEngineeringDir)config\test\Core\InstallTraceListener$(DefaultLanguageSourceExtension)')"/>
  </ItemGroup>

  <!--
    Include settings file (xunit.runner.json) if specified.
    Workaround for https://github.com/dotnet/arcade/issues/7080
  -->
  <ItemGroup>
    <None Include="$(XUnitDesktopSettingsFile)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(XUnitDesktopSettingsFile)' != '' and '$(TargetFrameworkIdentifier)' == '.NETFramework'" />

    <None Include="$(XUnitCoreSettingsFile)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(XUnitCoreSettingsFile)' != '' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp'" />
  </ItemGroup>

  <!-- Add a default test app.config, if the project doesn't already have one-->
  <Target Name="AddDefaultTestAppConfig">
    <PropertyGroup>
      <_AlreadyHasAppConfig Condition="'%(None.Filename)%(None.Extension)' == 'app.config'">true</_AlreadyHasAppConfig>
      <_ReferencesRoslynTestUtilities Condition="'%(ProjectReference.Filename)%(ProjectReference.Extension)' == 'Microsoft.CodeAnalysis.Test.Utilities.csproj'">true</_ReferencesRoslynTestUtilities>
      <_DefaultAppConfigFile Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">$(RepositoryEngineeringDir)config\test\Desktop\app.config</_DefaultAppConfigFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(_AlreadyHasAppConfig)' != 'true' and '$(_ReferencesRoslynTestUtilities)' == 'true'">
      <None Include="$(_DefaultAppConfigFile)" Condition="'$(_DefaultAppConfigFile)' != ''">
        <Link>app.config</Link>
      </None>
    </ItemGroup>
  </Target>

  <!--
    .NET Framework test assemblies are executables whose own PE header determines the default
    stack size of every thread in the test process, including the thread pool threads that
    xunit.v3 runs tests on. csc always emits a 1 MB stack reserve, which deep-recursion compiler
    tests overflow in Debug builds. Raising it to 4 MB matches the testhost.net47x.exe that
    previously hosted these tests.

    Only the copies in the output directory are patched. The intermediate assembly is left exactly
    as csc emitted it, so rebuild validation (eng/test-rebuild.ps1) can still reproduce it from
    source. Patched files are recreated rather than written in place, because CI builds
    (ROSLYNUSEHARDLINKS) hard link the output copy to the intermediate assembly. The last write time is restored after patching so the incremental copies that produce
    these files keep skipping them and downstream targets see no spurious change.
  -->
  <UsingTask TaskName="SetPEStackReserve"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <StackReserve ParameterType="System.Int64" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var originalLastWriteTimeUtc = File.GetLastWriteTimeUtc(FilePath);
        var bytes = File.ReadAllBytes(FilePath);

        var peHeaderOffset = BitConverter.ToInt32(bytes, 0x3C);
        if (BitConverter.ToUInt32(bytes, peHeaderOffset) != 0x00004550)
        {
            Log.LogError("'{0}' is not a PE file.", FilePath);
            return false;
        }

        // The optional header follows the 20-byte COFF header; SizeOfStackReserve is at offset 72 in both PE32 and PE32+.
        var optionalHeaderOffset = peHeaderOffset + 4 + 20;
        var stackReserveOffset = optionalHeaderOffset + 72;
        var magic = BitConverter.ToUInt16(bytes, optionalHeaderOffset);
        byte[] newValue;
        if (magic == 0x10B)
        {
            if (BitConverter.ToUInt32(bytes, stackReserveOffset) == (uint)StackReserve)
            {
                return true;
            }

            newValue = BitConverter.GetBytes((uint)StackReserve);
        }
        else if (magic == 0x20B)
        {
            if (BitConverter.ToUInt64(bytes, stackReserveOffset) == (ulong)StackReserve)
            {
                return true;
            }

            newValue = BitConverter.GetBytes((ulong)StackReserve);
        }
        else
        {
            Log.LogError("'{0}' has an unknown optional header magic 0x{1:X}.", FilePath, magic);
            return false;
        }

        Buffer.BlockCopy(newValue, 0, bytes, stackReserveOffset, newValue.Length);

        // CI builds copy outputs as hard links to the intermediate assembly. Deleting and recreating
        // the file breaks that link so the intermediate assembly is not modified.
        File.Delete(FilePath);
        File.WriteAllBytes(FilePath, bytes);
        File.SetLastWriteTimeUtc(FilePath, originalLastWriteTimeUtc);
]]></Code>
    </Task>
  </UsingTask>

  <!--
    xunit.v3's VSTest adapter launches .NET Framework test assemblies through an app host.
    Roslyn test projects use a .dll target extension to satisfy test naming checks, so provide
    a matching .exe host without changing the primary test artifact.
  -->
  <Target Name="CreateXunitV3AppHost"
          AfterTargets="Build"
          Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true' and '$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(OutputType)' == 'Exe' and '$(TargetExt)' == '.dll' and '$(DotNetBuildSourceOnly)' != 'true'">
    <PropertyGroup>
      <_XunitV3AppHost>$(TargetDir)$(TargetName).exe</_XunitV3AppHost>
      <_TargetConfigPath>$(TargetPath).config</_TargetConfigPath>
      <_XunitV3AppHostConfig>$(_XunitV3AppHost).config</_XunitV3AppHostConfig>
    </PropertyGroup>

    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(_XunitV3AppHost)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_TargetConfigPath)" DestinationFiles="$(_XunitV3AppHostConfig)" SkipUnchangedFiles="true" Condition="Exists('$(_TargetConfigPath)')" />

    <SetPEStackReserve FilePath="$(_XunitV3AppHost)" StackReserve="$(TestAssemblyStackReserve)" Condition="Exists('$(_XunitV3AppHost)')" />
  </Target>

  <!--
    XUnit.targets is imported after MSBuild has named the generated app config from the
    project's original library output. Native MTP launches the .exe, so give it the same
    binding redirects that MSBuild emitted for the historical .dll name.
  -->
  <Target Name="CreateXunitV3MtpAppConfig"
          AfterTargets="Build"
          Condition="'$(_RoslynUseMicrosoftTestingPlatform)' == 'true' and '$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(OutputType)' == 'Exe' and '$(DotNetBuildSourceOnly)' != 'true'">
    <PropertyGroup>
      <_XunitV3MtpSourceConfig>$(TargetDir)$(TargetName).dll.config</_XunitV3MtpSourceConfig>
      <_XunitV3MtpAppConfig>$(TargetDir)$(TargetName).exe.config</_XunitV3MtpAppConfig>
    </PropertyGroup>

    <Copy SourceFiles="$(_XunitV3MtpSourceConfig)"
          DestinationFiles="$(_XunitV3MtpAppConfig)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_XunitV3MtpSourceConfig)')" />
  </Target>

  <Target Name="SetTestAssemblyStackReserve"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(OutputType)' == 'Exe' and '$(DotNetBuildSourceOnly)' != 'true'">
    <PropertyGroup>
      <_TestExecutablePath Condition="'$(_RoslynUseMicrosoftTestingPlatform)' != 'true'">$(TargetPath)</_TestExecutablePath>
      <_TestExecutablePath Condition="'$(_RoslynUseMicrosoftTestingPlatform)' == 'true'">$(TargetDir)$(TargetName).exe</_TestExecutablePath>
    </PropertyGroup>

    <SetPEStackReserve FilePath="$(_TestExecutablePath)" StackReserve="$(TestAssemblyStackReserve)" Condition="Exists('$(_TestExecutablePath)')" />
  </Target>
</Project>
