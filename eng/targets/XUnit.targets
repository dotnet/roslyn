<?xml version="1.0" encoding="utf-8"?>
<!-- Licensed to the .NET Foundation under one or more agreements. The .NET Foundation licenses this file to you under the MIT license. See the LICENSE file in the project root for more information. -->
<Project>

  <PropertyGroup>
    <PrepareForBuildDependsOn>$(PrepareForBuildDependsOn);AddDefaultTestAppConfig</PrepareForBuildDependsOn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Test-only packages must not flow their runner and entry-point build assets into projects that reference test
      projects, e.g. IdeCoreBenchmarks and IdeBenchmarks reference the LanguageServer unit test projects.
    -->
    <PackageReference Include="XunitXml.TestLogger" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.mtp-off" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <!--
    xUnit seeds the generated entry point's namespace suffix with $(MSBuildProjectFullPath), so the emitted IL depends on
    the checkout path. eng/test-determinism.ps1 rebuilds from a different root (via subst) and requires identical
    binaries, so seed from the project name instead. xUnit declined to change the seed: https://github.com/xunit/xunit/issues/3624
  -->
  <Target Name="_XunitGenerateEntryPoint"
          Inputs="@(XunitEntryPointCachePath)"
          Outputs="$(_XunitEntryPointPath)"
          Condition="'$(XunitAutoGeneratedEntryPoint)' != 'false'"
          DependsOnTargets="_XunitCreateEntryPointCache">
    <XunitGenerateEntryPoint
        SourcePath="$(_XunitEntryPointPath)"
        RootNamespace="$(RootNamespace)"
        SuffixSeed="$(MSBuildProjectName)"
        Language="$(Language)"
        UseMicrosoftTestingPlatformRunner="off" />
    <ItemGroup>
      <FileWrites Include="$(_XunitEntryPointPath)" />
    </ItemGroup>
  </Target>

  <!--
    Replaces xUnit's target of the same name, which copies every file in
    _content\runners\{netfx,netcore}, including xunit.abstractions.dll. xunit.runner.visualstudio
    also copies xunit.abstractions.dll to the output directory, and BuildBoss fails the build on
    multiple writes to the same output file. Copy only the framework-specific runner utility.
  -->
  <Target Name="_XunitCopyRunnerDependencies"
          AfterTargets="Build"
          Condition="('$(TargetFrameworkIdentifier)' == '.NETFramework' or '$(TargetFrameworkIdentifier)' == '.NETCoreApp') and '$(DotNetBuildSourceOnly)' != 'true'">
    <ItemGroup>
      <_XunitRunnerUtilityPackageReference Include="@(PackageReference)"
                                           Condition="'%(PackageReference.Identity)' == 'xunit.v3.runner.utility'" />
      <_XunitRunnerUtility
          Include="$(NuGetPackageRoot)xunit.v3.core.mtp-off\$(_xunitVersion)\_content\runners\netfx\xunit.v3.runner.utility.netfx.dll"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '@(_XunitRunnerUtilityPackageReference)' == ''" />
      <_XunitRunnerUtility
          Include="$(NuGetPackageRoot)xunit.v3.core.mtp-off\$(_xunitVersion)\_content\runners\netcore\xunit.v3.runner.utility.netcore.dll"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' and '@(_XunitRunnerUtilityPackageReference)' == ''" />
    </ItemGroup>

    <Copy SourceFiles="@(_XunitRunnerUtility)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(_XunitRunnerUtility->'$(TargetDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!--
    xUnit v3 runs .NET Framework tests inside the test executable, so test and worker threads get the
    stack reserve from its PE header. The compiler only emits a 4 MB stack reserve for 64-bit-only
    executables and uses 1 MB for AnyCPU. The VSTest x64 .NET Framework testhost previously used to run
    these tests reserves 4 MB, and deep recursion tests (e.g. deeply nested initializers) depend on that
    headroom. Patch only the copy in the output directory: determinism and rebuild validation compare
    the unpatched compiler output in the obj directory.
  -->
  <UsingTask TaskName="SetStackReserveSize"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
      <StackReserveSize ParameterType="System.Int64" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var lastWriteTimeUtc = File.GetLastWriteTimeUtc(FilePath);
        using (var stream = new FileStream(FilePath, FileMode.Open, FileAccess.ReadWrite, FileShare.Read))
        using (var reader = new BinaryReader(stream))
        using (var writer = new BinaryWriter(stream))
        {
            stream.Position = 0x3C;
            var peHeaderOffset = reader.ReadInt32();
            stream.Position = peHeaderOffset;
            if (reader.ReadUInt32() != 0x00004550)
            {
                Log.LogError("'{0}' is not a PE file.", FilePath);
                return false;
            }

            // The optional header follows the 4-byte signature and 20-byte COFF header.
            // SizeOfStackReserve is at offset 72 for both PE32 and PE32+.
            var optionalHeaderOffset = peHeaderOffset + 24;
            stream.Position = optionalHeaderOffset;
            var isPE32Plus = reader.ReadUInt16() == 0x20B;
            stream.Position = optionalHeaderOffset + 72;
            var currentSize = isPE32Plus ? (long)reader.ReadUInt64() : reader.ReadUInt32();
            if (currentSize < StackReserveSize)
            {
                stream.Position = optionalHeaderOffset + 72;
                if (isPE32Plus)
                    writer.Write((ulong)StackReserveSize);
                else
                    writer.Write((uint)StackReserveSize);
            }
        }

        // Keep the timestamp so incremental copies from obj still treat the file as up to date.
        File.SetLastWriteTimeUtc(FilePath, lastWriteTimeUtc);
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_SetTestExecutableStackReserveSize"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(OutputType)' == 'Exe' and Exists('$(TargetPath)')">
    <SetStackReserveSize FilePath="$(TargetPath)" StackReserveSize="4194304" />
  </Target>

  <ItemGroup>
    <!-- Include BannedSymbols covering all test projects -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\config\test\BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework' AND '$(SkipRoslynTestTraceListener)' != 'true'">
    <!--
      For .NET Core, app.config is not available. Languages which support module initializers may provide an
      InstallTraceListener.* source file which gets added to the build for test projects to programmatically install the
      trace listener. Together with app.config support, this means the trace listener is automatically set for:

      1. All C# test projects
      2. All Visual Basic test projects running on .NET Framework
    -->
    <Compile Include="$(RepositoryEngineeringDir)config\test\Core\InstallTraceListener$(DefaultLanguageSourceExtension)"
             Condition="Exists('$(RepositoryEngineeringDir)config\test\Core\InstallTraceListener$(DefaultLanguageSourceExtension)')"/>
  </ItemGroup>

  <!--
    Include settings file (xunit.runner.json) if specified.
    Workaround for https://github.com/dotnet/arcade/issues/7080
  -->
  <ItemGroup>
    <None Include="$(XUnitDesktopSettingsFile)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(XUnitDesktopSettingsFile)' != '' and '$(TargetFrameworkIdentifier)' == '.NETFramework'" />

    <None Include="$(XUnitCoreSettingsFile)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(XUnitCoreSettingsFile)' != '' and '$(TargetFrameworkIdentifier)' == '.NETCoreApp'" />
  </ItemGroup>

  <!-- Add a default test app.config, if the project doesn't already have one-->
  <Target Name="AddDefaultTestAppConfig">
    <PropertyGroup>
      <_AlreadyHasAppConfig Condition="'%(None.Filename)%(None.Extension)' == 'app.config'">true</_AlreadyHasAppConfig>
      <_ReferencesRoslynTestUtilities Condition="'%(ProjectReference.Filename)%(ProjectReference.Extension)' == 'Microsoft.CodeAnalysis.Test.Utilities.csproj'">true</_ReferencesRoslynTestUtilities>
      <_DefaultAppConfigFile Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">$(RepositoryEngineeringDir)config\test\Desktop\app.config</_DefaultAppConfigFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(_AlreadyHasAppConfig)' != 'true' and '$(_ReferencesRoslynTestUtilities)' == 'true'">
      <None Include="$(_DefaultAppConfigFile)" Condition="'$(_DefaultAppConfigFile)' != ''">
        <Link>app.config</Link>
      </None>
    </ItemGroup>
  </Target>
</Project>
