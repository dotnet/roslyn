<?xml version="1.0" encoding="utf-8"?>

<!-- The default app.config for test projects that do not specify one -->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <!-- NuGet.Packaging 6.3.4 retains a runtime-only reference to NuGet.Versioning
             6.3.4.2, while test outputs contain 6.14.3.1. RAR sees only the resolved
             6.14.3.1 asset, so automatic binding redirect generation cannot detect
             this conflict. -->
        <assemblyIdentity name="NuGet.Versioning" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.14.3.1" newVersion="6.14.3.1" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.diagnostics>
    <trace>
      <listeners>
        <remove name="Default" />
        <add name="ThrowingTraceListener" type="Microsoft.CodeAnalysis.ThrowingTraceListener, Microsoft.CodeAnalysis.Test.Utilities" />
      </listeners>
    </trace>
  </system.diagnostics>
</configuration>
